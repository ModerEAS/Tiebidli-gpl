# 已有 Typecho 1.2 数据库。不要把真实口令写进 git。
DATABASE_URL=mysql://user:password@127.0.0.1:3306/typecho
# 表前缀，默认 typecho_
TYPECHO_PREFIX=typecho_
# 对外站点地址，覆盖库里的 siteUrl。用于 RSS 绝对链接。
SITE_URL=https://example.com
LISTEN=0.0.0.0:8080
# 本机主题静态目录，挂到 /usr/themes/{options.theme}/。不入库。
THEME_STATIC_DIR=./themes/default
# 可选。同名 html 覆盖内置模板：base.html list.html single.html search.html 404.html
# THEME_DIR=./themes/templates
# Typecho 上传目录，对应 /usr/uploads/
UPLOADS_DIR=./usr/uploads
# 备份文件目录，对应原版备份目录。导出会在这里留一份 .dat，页面也可以从这里恢复。
BACKUP_DIR=./usr/backups
# 可选，评论头像前缀。国内可改为 https://cravatar.cn/avatar/
# GRAVATAR_PREFIX=https://secure.gravatar.com/avatar/
# STATIC_DIR=./static
